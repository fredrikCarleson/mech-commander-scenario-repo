# Google OAuth audiences. Staging and production require both lists.
GOOGLE_WEB_CLIENT_IDS=
GOOGLE_DESKTOP_CLIENT_IDS=
# Development-only migration fallbacks:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
VITE_GOOGLE_CLIENT_ID=

# Immutable Google subjects allowed to approve uploads
ADMIN_GOOGLE_SUBS=

# At least 32 random bytes for short-lived creator sessions
SESSION_SIGNING_SECRET=

# Environment identity. Candidate/production values must be set contextually in Netlify.
COMMUNITY_ENVIRONMENT=development
COMMUNITY_API_ORIGIN=http://localhost:8888/api/v1
SESSION_SIGNING_SECRET_ID=development-v1
COMMUNITY_MUTATION_MODE=authenticated
COMMUNITY_CORS_ORIGINS=http://localhost:8888,http://localhost:5173,http://127.0.0.1:42647

# Isolated development store. Staging and production use reviewed contextual values.
SCENARIO_BLOB_STORE=mech-scenarios-development-v1
